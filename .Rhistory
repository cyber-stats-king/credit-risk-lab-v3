0.025 * employment_years
true_pd <- plogis(log_odds)
default_flag <- rbinom(
n,
size = 1,
prob = true_pd
)
# ------------------------------------------------------------
# 5. Additional outcome and recovery variables
# ------------------------------------------------------------
loan_status <- ifelse(
default_flag == 1,
sample(c("Default", "Collections", "Written Off"),
n, replace = TRUE),
sample(c("Current", "Closed", "Paid"),
n, replace = TRUE)
)
recovery_rate <- round(
pmin(pmax(rbeta(n, 2, 5), 0), 1),
4
)
recovery_amount <- round(
current_balance * recovery_rate,
2
)
collection_cost <- round(
ifelse(default_flag == 1,
runif(n, 500, 15000),
0),
2
)
# ------------------------------------------------------------
# 6. Combine into a data frame
# ------------------------------------------------------------
portfolio_data <- data.frame(
credit_score,
employment_years,
debt_to_income,
credit_utilization,
inquiries_6mths,
delinquencies_2yrs,
annual_income,
credit_limit,
interest_rate,
loan_amount,
current_balance,
loan_term,
home_ownership,
loan_purpose,
employment_type,
collateral_type,
verification_status,
default_flag,
loan_status,
recovery_rate,
recovery_amount,
collection_cost
)
# ------------------------------------------------------------
# 7. Introduce missing values
# ------------------------------------------------------------
portfolio_data$credit_score[
sample(1:n, 120)
] <- NA
portfolio_data$employment_years[
sample(1:n, 250)
] <- NA
portfolio_data$annual_income[
sample(1:n, 300)
] <- NA
portfolio_data$home_ownership[
sample(1:n, 150)
] <- NA
portfolio_data$collateral_type[
sample(1:n, 100)
] <- NA
# ------------------------------------------------------------
# 8. Export CSV
# ------------------------------------------------------------
write.csv(
portfolio_data,
"credit_risk_portfolio_test.csv",
row.names = FALSE,
na = ""
)
# ------------------------------------------------------------
# 9. Basic validation
# ------------------------------------------------------------
cat("Observations:", nrow(portfolio_data), "\n")
cat("Variables:", ncol(portfolio_data), "\n")
cat("\nVariable names:\n")
print(names(portfolio_data))
cat("\nMissing values by variable:\n")
print(colSums(is.na(portfolio_data)))
cat("\nDefault rate:\n")
print(mean(portfolio_data$default_flag))
head(portfolio_data)
predictor_test_data <- data.frame(
credit_score,
employment_years,
age,
debt_to_income,
credit_utilization,
inquiries_6mths,
delinquencies_2yrs,
annual_income,
home_ownership,
loan_purpose,
total_accounts,
collateral_type,
loan_term,
public_records,
loan_status,
PD_estimate,
default_flag
)
# ============================================================
# CREDIT RISK LAB
# SYNTHETIC TEST DATASETS
# Dataset 2: General Credit Portfolio
# Dataset 3: Predictor-focused Modelling Dataset
# 10,000 observations per dataset
# ============================================================
set.seed(20261104)
n <- 10000
# ------------------------------------------------------------
# CREATE OUTPUT DIRECTORY
# ------------------------------------------------------------
output_dir <- "CreditRisk_Lab_Test_Datasets"
if (!dir.exists(output_dir)) {
dir.create(output_dir, recursive = TRUE)
}
# ============================================================
# DATASET 2: GENERAL CREDIT PORTFOLIO
# ============================================================
cat("\nGenerating Dataset 2...\n")
# ------------------------------------------------------------
# 1. Core credit risk variables
# ------------------------------------------------------------
credit_score <- round(rnorm(n, mean = 620, sd = 75))
credit_score <- pmin(pmax(credit_score, 300), 850)
employment_years <- round(
runif(n, min = 0, max = 35), 1
)
debt_to_income <- round(
rbeta(n, shape1 = 3, shape2 = 5) * 100, 2
)
credit_utilization <- round(
rbeta(n, shape1 = 2, shape2 = 4), 4
)
inquiries_6mths <- rpois(n, lambda = 1.5)
delinquencies_2yrs <- rpois(n, lambda = 0.7)
annual_income <- round(
rlnorm(n, meanlog = log(420000), sdlog = 0.45), 2
)
# ------------------------------------------------------------
# 2. Loan and exposure variables
# ------------------------------------------------------------
credit_limit <- round(
runif(n, min = 10000, max = 250000), 2
)
interest_rate <- round(
runif(n, min = 7, max = 28), 2
)
loan_amount <- round(
runif(n, min = 5000, max = 300000), 2
)
current_balance <- round(
loan_amount * runif(n, min = 0.2, max = 1), 2
)
loan_term <- sample(
c(6, 12, 18, 24, 36, 48, 60),
size = n,
replace = TRUE
)
# ------------------------------------------------------------
# 3. Categorical variables
# ------------------------------------------------------------
home_ownership <- sample(
c("Own", "Mortgage", "Rent", "Other"),
size = n,
replace = TRUE,
prob = c(0.20, 0.35, 0.35, 0.10)
)
loan_purpose <- sample(
c(
"Debt Consolidation",
"Vehicle",
"Home Improvement",
"Education",
"Business",
"Other"
),
size = n,
replace = TRUE
)
employment_type <- sample(
c("Permanent", "Contract", "Self-employed", "Unemployed"),
size = n,
replace = TRUE,
prob = c(0.60, 0.18, 0.17, 0.05)
)
collateral_type <- sample(
c("Property", "Vehicle", "Cash", "None"),
size = n,
replace = TRUE
)
verification_status <- sample(
c("Verified", "Partially Verified", "Unverified"),
size = n,
replace = TRUE,
prob = c(0.55, 0.30, 0.15)
)
# ------------------------------------------------------------
# 4. Generate default outcome
# ------------------------------------------------------------
log_odds <- -2.8 -
0.006 * (credit_score - 620) +
0.025 * (debt_to_income - 40) +
0.65 * credit_utilization +
0.30 * inquiries_6mths +
0.45 * delinquencies_2yrs -
0.025 * employment_years
true_pd <- plogis(log_odds)
default_flag <- rbinom(
n,
size = 1,
prob = true_pd
)
# ------------------------------------------------------------
# 5. Loan status and recovery variables
# ------------------------------------------------------------
loan_status <- ifelse(
default_flag == 1,
sample(
c("Default", "Collections", "Written Off"),
n,
replace = TRUE
),
sample(
c("Current", "Closed", "Paid"),
n,
replace = TRUE
)
)
recovery_rate <- round(
rbeta(n, shape1 = 2, shape2 = 5), 4
)
recovery_amount <- round(
current_balance * recovery_rate, 2
)
collection_cost <- round(
ifelse(
default_flag == 1,
runif(n, min = 500, max = 15000),
0
), 2
)
# ------------------------------------------------------------
# 6. Combine Dataset 2
# ------------------------------------------------------------
portfolio_data <- data.frame(
credit_score,
employment_years,
debt_to_income,
credit_utilization,
inquiries_6mths,
delinquencies_2yrs,
annual_income,
credit_limit,
interest_rate,
loan_amount,
current_balance,
loan_term,
home_ownership,
loan_purpose,
employment_type,
collateral_type,
verification_status,
default_flag,
loan_status,
recovery_rate,
recovery_amount,
collection_cost
)
# ------------------------------------------------------------
# 7. Introduce missing values
# ------------------------------------------------------------
portfolio_data$credit_score[
sample(1:n, 120)
] <- NA
portfolio_data$employment_years[
sample(1:n, 250)
] <- NA
portfolio_data$annual_income[
sample(1:n, 300)
] <- NA
portfolio_data$home_ownership[
sample(1:n, 150)
] <- NA
portfolio_data$collateral_type[
sample(1:n, 100)
] <- NA
# ------------------------------------------------------------
# 8. Export Dataset 2
# ------------------------------------------------------------
write.csv(
portfolio_data,
file = file.path(
output_dir,
"credit_risk_portfolio_test.csv"
),
row.names = FALSE,
na = ""
)
# ============================================================
# DATASET 3: PREDICTOR-FOCUSED MODELLING DATASET
# ============================================================
cat("\nGenerating Dataset 3...\n")
set.seed(20261105)
# ------------------------------------------------------------
# 1. Stronger predictors
# ------------------------------------------------------------
credit_score <- round(
rnorm(n, mean = 630, sd = 70)
)
credit_score <- pmin(pmax(credit_score, 300), 850)
employment_years <- round(
runif(n, min = 0, max = 35), 1
)
age <- sample(
21:75,
size = n,
replace = TRUE
)
debt_to_income <- round(
rbeta(n, shape1 = 3, shape2 = 5) * 100, 2
)
credit_utilization <- round(
rbeta(n, shape1 = 2, shape2 = 4), 4
)
inquiries_6mths <- rpois(n, lambda = 1.5)
delinquencies_2yrs <- rpois(n, lambda = 0.7)
# ------------------------------------------------------------
# 2. Weaker predictors
# ------------------------------------------------------------
annual_income <- round(
rlnorm(n, meanlog = log(450000), sdlog = 0.5), 2
)
home_ownership <- sample(
c("Own", "Mortgage", "Rent", "Other"),
n,
replace = TRUE
)
loan_purpose <- sample(
c(
"Personal",
"Vehicle",
"Education",
"Business",
"Debt Consolidation"
),
n,
replace = TRUE
)
total_accounts <- sample(
1:30,
n,
replace = TRUE
)
collateral_type <- sample(
c("Property", "Vehicle", "Cash", "None"),
n,
replace = TRUE
)
loan_term <- sample(
c(6, 12, 18, 24, 36, 48, 60),
n,
replace = TRUE
)
public_records <- rpois(
n,
lambda = 0.15
)
# ------------------------------------------------------------
# 3. Generate default probability
# ------------------------------------------------------------
log_odds <- -3.0 -
0.012 * (credit_score - 630) +
0.035 * (debt_to_income - 40) +
1.2 * credit_utilization +
0.35 * inquiries_6mths +
0.55 * delinquencies_2yrs -
0.025 * employment_years +
0.008 * (age - 40)
true_pd <- plogis(log_odds)
default_flag <- rbinom(
n,
size = 1,
prob = true_pd
)
PD_estimate <- round(true_pd, 6)
# ------------------------------------------------------------
# 4. Variable with no intended predictive signal
# ------------------------------------------------------------
loan_status <- sample(
c("Active", "Closed", "Restructured", "Paid"),
n,
replace = TRUE
)
# ------------------------------------------------------------
# 5. Combine Dataset 3
# ------------------------------------------------------------
predictor_test_data <- data.frame(
credit_score,
employment_years,
age,
debt_to_income,
credit_utilization,
inquiries_6mths,
delinquencies_2yrs,
annual_income,
home_ownership,
loan_purpose,
total_accounts,
collateral_type,
loan_term,
public_records,
loan_status,
PD_estimate,
default_flag
)
# ------------------------------------------------------------
# 6. Introduce missing values
# ------------------------------------------------------------
# CREDIT_SCORE: 5 missing values (99.95% complete)
predictor_test_data$credit_score[
sample(1:n, 5)
] <- NA
predictor_test_data$employment_years[
sample(1:n, 150)
] <- NA
predictor_test_data$debt_to_income[
sample(1:n, 200)
] <- NA
predictor_test_data$annual_income[
sample(1:n, 500)
] <- NA
predictor_test_data$home_ownership[
sample(1:n, 250)
] <- NA
predictor_test_data$loan_purpose[
sample(1:n, 350)
] <- NA
predictor_test_data$collateral_type[
sample(1:n, 400)
] <- NA
# ------------------------------------------------------------
# 7. Export Dataset 3
# ------------------------------------------------------------
write.csv(
predictor_test_data,
file = file.path(
output_dir,
"credit_risk_predictor_test.csv"
),
row.names = FALSE,
na = ""
)
# ============================================================
# FINAL VALIDATION AND EXPORT CONFIRMATION
# ============================================================
cat("\n============================================\n")
cat("CREDIT RISK LAB: DATASET GENERATION COMPLETE\n")
cat("============================================\n")
# Dataset 2 summary
cat("\nDATASET 2: GENERAL CREDIT PORTFOLIO\n")
cat("Observations:", nrow(portfolio_data), "\n")
cat("Variables:", ncol(portfolio_data), "\n")
cat("Default rate:",
round(mean(portfolio_data$default_flag), 4), "\n")
cat("\nMissing values:\n")
print(colSums(is.na(portfolio_data)))
# Dataset 3 summary
cat("\nDATASET 3: PREDICTOR-FOCUSED DATASET\n")
cat("Observations:", nrow(predictor_test_data), "\n")
cat("Variables:", ncol(predictor_test_data), "\n")
cat("Default rate:",
round(mean(predictor_test_data$default_flag), 4), "\n")
cat(
"CREDIT_SCORE completeness:",
round(
mean(!is.na(predictor_test_data$credit_score)) * 100,
2
),
"%\n"
)
cat("\nMissing values:\n")
print(colSums(is.na(predictor_test_data)))
# Confirm exported files
cat("\nEXPORTED FILES:\n")
exported_files <- list.files(
output_dir,
full.names = TRUE
)
print(exported_files)
cat("\nOUTPUT DIRECTORY:\n")
cat(normalizePath(output_dir), "\n")
cat("\nBoth datasets generated and exported successfully.\n")
View(portfolio_data)
View(predictor_test_data)
View(portfolio_data)
